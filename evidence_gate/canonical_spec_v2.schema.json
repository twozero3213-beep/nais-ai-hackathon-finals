{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NAIS canonical analysis spec v2 (unapproved candidate)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "spec_version",
    "claim_id",
    "method",
    "reported_value",
    "variable",
    "filters",
    "missing_policy",
    "missing_tokens",
    "denominator",
    "unit",
    "data_fingerprint",
    "tolerance",
    "source_location",
    "field_evidence",
    "unresolved",
    "outcome",
    "predictors",
    "reported",
    "reported_df",
    "data_id_column",
    "reference_ids_source"
  ],
  "properties": {
    "spec_version": {
      "const": 2
    },
    "claim_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "method": {
      "enum": [
        "row_count",
        "mean",
        "ols_regression",
        "row_alignment",
        null
      ]
    },
    "reported_value": {
      "type": [
        "number",
        "null"
      ]
    },
    "variable": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 128
    },
    "filters": {
      "type": [
        "array",
        "null"
      ],
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "column",
          "operator",
          "value"
        ],
        "properties": {
          "column": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "operator": {
            "const": "eq"
          },
          "value": {
            "type": [
              "string",
              "number"
            ]
          }
        }
      }
    },
    "missing_policy": {
      "enum": [
        "error",
        "complete_case",
        "not_applicable",
        null
      ]
    },
    "missing_tokens": {
      "type": [
        "array",
        "null"
      ],
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "maxLength": 32
      }
    },
    "denominator": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 4000
    },
    "unit": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 4000
    },
    "data_fingerprint": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{64}$"
    },
    "tolerance": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "source_location": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source_id",
            "locator",
            "quote"
          ],
          "properties": {
            "source_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "locator": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "quote": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4000
            }
          }
        }
      ]
    },
    "field_evidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "method": {
          "type": [
            "array",
            "null"
          ],
          "maxItems": 8,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          }
        },
        "reported_value": {
          "type": [
            "array",
            "null"
          ],
          "maxItems": 8,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          }
        },
        "variable": {
          "type": [
            "array",
            "null"
          ],
          "maxItems": 8,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          }
        },
        "filters": {
          "type": [
            "array",
            "null"
          ],
          "maxItems": 8,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          }
        },
        "missing_policy": {
          "type": [
            "array",
            "null"
          ],
          "maxItems": 8,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          }
        },
        "missing_tokens": {
          "type": [
            "array",
            "null"
          ],
          "maxItems": 8,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          }
        },
        "denominator": {
          "type": [
            "array",
            "null"
          ],
          "maxItems": 8,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          }
        },
        "unit": {
          "type": [
            "array",
            "null"
          ],
          "maxItems": 8,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          }
        },
        "data_fingerprint": {
          "type": [
            "array",
            "null"
          ],
          "maxItems": 8,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          }
        },
        "tolerance": {
          "type": [
            "array",
            "null"
          ],
          "maxItems": 8,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          }
        },
        "outcome": {
          "type": [
            "array",
            "null"
          ],
          "maxItems": 8,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          }
        },
        "predictors": {
          "type": [
            "array",
            "null"
          ],
          "maxItems": 8,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          }
        },
        "reported": {
          "type": [
            "array",
            "null"
          ],
          "maxItems": 8,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          }
        },
        "reported_df": {
          "type": [
            "array",
            "null"
          ],
          "maxItems": 8,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          }
        },
        "data_id_column": {
          "type": [
            "array",
            "null"
          ],
          "maxItems": 8,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          }
        },
        "reference_ids_source": {
          "type": [
            "array",
            "null"
          ],
          "maxItems": 8,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          }
        }
      }
    },
    "unresolved": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512
      }
    },
    "outcome": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 128
    },
    "predictors": {
      "type": [
        "array",
        "null"
      ],
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      }
    },
    "reported": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "b",
          "se",
          "t"
        ],
        "properties": {
          "b": {
            "type": [
              "number",
              "null"
            ]
          },
          "se": {
            "type": [
              "number",
              "null"
            ]
          },
          "t": {
            "type": [
              "number",
              "null"
            ]
          }
        }
      }
    },
    "reported_df": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "data_id_column": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 128
    },
    "reference_ids_source": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 4000
    }
  },
  "$comment": "3 조지현: docs/finals-strategy/extraction.schema.json(v1)을 기준으로 방법 4종·자료 지문·허용오차·회귀·행 대응 필드를 더한 정규 명세. 방법별 필수 조건과 교차 규칙은 evidence_gate/spec.py validate가 판정한다. 형식 통과는 원문 해석 승인이 아니다."
}
