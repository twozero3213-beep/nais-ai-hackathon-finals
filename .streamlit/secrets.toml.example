# [작성: 0 이영] 2026-09-30 22:52 KST — 팀별 비밀번호 해시·권한 계약을 보여 주며 실제 비밀값은 포함하지 않습니다.
# 실제 파일 생성: python tools/0_이영_팀접속설정.py
# 터미널에서 네 명의 서로 다른 비밀번호를 입력합니다. 이 예제만 복사하면 로그인은 차단됩니다.
# 생성된 .streamlit/secrets.toml은 Git 제외 파일입니다. 값을 채팅·로그·커밋에 복사하지 않습니다.
# 클라우드에는 EVIDENCE_GATE_LOCAL_MODE를 설정하지 않습니다.
[team]
branch = "team-data"
# 공용 저장이 필요하면 별도의 비공개 저장소·최소 권한 토큰을 비밀 설정에서 관리합니다.
# repo = "owner/private-data-repository"
# token은 이 예제에 넣지 않습니다.

[team.roles]
"이영" = "ADMIN"
"조지현" = "REVIEWER"
"이채우" = "REVIEWER"
"임도윤" = "REVIEWER"

[team.password_hashes]
# 네 명의 pbkdf2_sha256 해시는 설정 생성 도구가 작성합니다.
